rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(username) {
      // In this app, usernames are used as doc IDs. 
      // This is slightly tricky if we don't have a mapping of UID to username.
      // However, for now we will trust the existing structure or rely on isAdmin for management.
      return isSignedIn(); 
    }

    // Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Only existing admins can manage admins (Super Admin logic would be better but keeping it simple for now)
    }

    // Global Settings
    match /settings/global {
      allow read: if true; // Everyone needs to read settings
      allow write: if isAdmin();
    }

    // Investment Plans
    match /investment_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs
    match /balance_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // KudiGrid User document
    match /users/{username} {
      allow read, write: if true; // Relaxed for custom auth system

      match /payouts/{payoutId} {
        allow read, write: if true;
      }

      match /referralTransactions/{txId} {
        allow read, write: if true;
      }

      match /completedTasks/{taskId} {
        allow read, write: if true;
      }

      match /deposits/{depositId} {
        allow read, write: if true;
      }
    }

    // Root collections
    match /all_deposits/{depositId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /referral_rewards/{rewardId} {
      allow read, write: if true;
    }
  }
}
